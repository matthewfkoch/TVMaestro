<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TVMaestro" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:buttonStyle">@style/Widget.TVMaestro.Button</item>
        <item name="buttonStyle">@style/Widget.TVMaestro.Button</item>
        <item name="editTextStyle">@style/Widget.TVMaestro.Field</item>
        <item name="android:editTextStyle">@style/Widget.TVMaestro.Field</item>
    </style>

    <style name="Widget.TVMaestro.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:stateListAnimator">@animator/focus_scale</item>
    </style>

    <style name="Widget.TVMaestro.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/accent_on</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.TVMaestro.Field" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Text.TVMaestro.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
