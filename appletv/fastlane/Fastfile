require "json"

default_platform(:tvos)

def testflight_config
  path = File.expand_path("../testflight.json", __dir__)
  JSON.parse(File.read(path))
rescue Errno::ENOENT, JSON::ParserError
  {}
end

platform :tvos do
  desc "Register bundle ID + App Store Connect app (one-time)"
  lane :setup do
    cfg = testflight_config
    apple_id = ENV.fetch("FASTLANE_USER") { UI.input("Apple ID: ") }
    team_id = ENV.fetch("APPLE_TEAM_ID") { UI.input("Team ID (10 chars, developer.apple.com/account): ") }

    produce(
      app_identifier: cfg["bundleId"] || "com.tvmaestro.client",
      app_name: cfg["appName"] || "TVMaestro",
      app_version: "0.4.0",
      sku: "tvmaestro-appletv",
      platform: "tvos",
      username: apple_id,
      team_id: team_id,
      skip_itc: false,
      skip_devcenter: false
    )

    UI.success("Created/verified App Store Connect app. Copy the numeric Apple ID into appletv/testflight.json → ascAppId")
  end

  desc "Build Release and upload to TestFlight"
  lane :beta do
    cfg = testflight_config
    team_id = resolve_team_id

    marketing_version = marketing_version_for_upload("TVMaestro.xcodeproj", "TVMaestro")
    increment_build_number(
      build_number: next_testflight_build_number(
        app_identifier: cfg["bundleId"] || "com.tvmaestro.client",
        marketing_version: marketing_version,
        platform: "appletvos"
      ).to_s,
      xcodeproj: "TVMaestro.xcodeproj"
    )

    build_app(
      project: "TVMaestro.xcodeproj",
      scheme: "TVMaestro",
      configuration: "Release",
      export_method: "app-store",
      destination: "generic/platform=tvOS",
      xcargs: signing_xcargs(team_id),
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: team_id,
        uploadSymbols: true,
        uploadBitcode: false
      }
    )

    upload_args = upload_credentials_hash.merge(
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
    asc = cfg["ascAppId"]
    upload_args[:apple_id] = asc if asc && !asc.to_s.include?("REPLACE")

    upload_to_testflight(**upload_args)
  end

  desc "Build App Store IPA locally (no upload)"
  lane :build do
    team_id = resolve_team_id
    build_app(
      project: "TVMaestro.xcodeproj",
      scheme: "TVMaestro",
      configuration: "Release",
      export_method: "app-store",
      destination: "generic/platform=tvOS",
      xcargs: signing_xcargs(team_id),
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: team_id
      }
    )
  end

  desc "Upload tvOS App Store listing only (no binary, no review submission)"
  lane :metadata do
    cfg = testflight_config
    version = get_version_number(
      xcodeproj: "TVMaestro.xcodeproj",
      target: "TVMaestro"
    )

    upload_args = upload_credentials_hash.merge(
      app_identifier: cfg["bundleId"] || "com.tvmaestro.client",
      app_version: version,
      platform: "appletvos",
      team_id: resolve_team_id,
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false,
      metadata_path: "fastlane/metadata",
      app_rating_config_path: "fastlane/metadata/rating_config.json"
    )

    upload_to_app_store(**upload_args)
  end

  desc "Submit an existing tvOS TestFlight build for App Store review"
  lane :submit do
    cfg = testflight_config
    version = submit_version("TVMaestro.xcodeproj", "TVMaestro")
    build_number = required_build_number
    app_identifier = cfg["bundleId"] || "com.tvmaestro.client"

    ensure_build_processed(
      app_identifier: app_identifier,
      marketing_version: version,
      build_number: build_number,
      platform: "TV_OS"
    )

    upload_args = upload_credentials_hash.merge(
      app_identifier: app_identifier,
      app_version: version,
      build_number: build_number,
      platform: "appletvos",
      team_id: resolve_team_id,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: automatic_release?,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
        add_id_info_uses_idfa: false
      }
    )

    upload_to_app_store(**upload_args)
  end

  desc "Upload tvOS screenshots only (no binary, no metadata, no review submission)"
  lane :screenshots do
    cfg = testflight_config
    version = get_version_number(
      xcodeproj: "TVMaestro.xcodeproj",
      target: "TVMaestro"
    )

    upload_args = upload_credentials_hash.merge(
      app_identifier: cfg["bundleId"] || "com.tvmaestro.client",
      app_version: version,
      platform: "appletvos",
      team_id: resolve_team_id,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false
    )

    upload_to_app_store(**upload_args)
  end

  def signing_xcargs(team_id)
    args = ["-allowProvisioningUpdates", "DEVELOPMENT_TEAM=#{team_id}"]
    # GitHub has no Apple ID session, so the runner must sign with the API key.
    # A local Mac already signed into Xcode can create the App Store certificate;
    # passing the API key there blocks that and fails cloud signing.
    if ENV["GITHUB_ACTIONS"] == "true"
      key_path = ENV["ASC_API_KEY_PATH"]
      key_id = ENV["ASC_KEY_ID"]
      issuer_id = ENV["ASC_ISSUER_ID"]
      if key_path && !key_path.empty? && key_id && !key_id.empty? && issuer_id && !issuer_id.empty?
        args << "-authenticationKeyPath #{key_path}"
        args << "-authenticationKeyID #{key_id}"
        args << "-authenticationKeyIssuerID #{issuer_id}"
      end
    end
    args.join(" ")
  end

  private_lane :resolve_team_id do
    if ENV["APPLE_TEAM_ID"] && !ENV["APPLE_TEAM_ID"].empty?
      ENV["APPLE_TEAM_ID"]
    else
      UI.user_error!(
        "Set APPLE_TEAM_ID (10 characters, from developer.apple.com/account → Membership)"
      )
    end
  end

  def marketing_version_for_upload(xcodeproj, target)
    if ENV["GITHUB_REF_NAME"]&.match?(/\Av\d+\.\d+\.\d+\z/)
      version = ENV["GITHUB_REF_NAME"].delete_prefix("v")
      increment_version_number(version_number: version, xcodeproj: xcodeproj)
      return version
    end
    get_version_number(xcodeproj: xcodeproj, target: target)
  end

  def next_testflight_build_number(app_identifier:, marketing_version:, platform:)
    creds = upload_credentials_hash
    options = {
      app_identifier: app_identifier,
      platform: platform,
      version: marketing_version,
      initial_build_number: 0
    }
    options[:api_key] = creds[:api_key] if creds[:api_key]
    options[:username] = creds[:username] if creds[:username]
    # latest_testflight_build_number rejects the tvOS lane, so call the action directly.
    config = FastlaneCore::Configuration.create(
      Fastlane::Actions::LatestTestflightBuildNumberAction.available_options,
      options
    )
    Fastlane::Actions::LatestTestflightBuildNumberAction.run(config).to_i + 1
  end

  def submit_version(xcodeproj, target)
    version = ENV["APP_VERSION"].to_s
    return version unless version.empty?
    get_version_number(xcodeproj: xcodeproj, target: target)
  end

  def required_build_number
    build_number = ENV["BUILD_NUMBER"].to_s
    if build_number.empty?
      UI.user_error!("Set BUILD_NUMBER to the processed TestFlight build to submit")
    end
    build_number
  end

  def automatic_release?
    ENV.fetch("AUTOMATIC_RELEASE", "false").to_s.downcase == "true"
  end

  def ensure_build_processed(app_identifier:, marketing_version:, build_number:, platform:)
    creds = upload_credentials_hash
    if creds[:api_key]
      Spaceship::ConnectAPI.token ||= Spaceship::ConnectAPI::Token.create(**creds[:api_key])
    elsif creds[:username] && Spaceship::ConnectAPI.token.nil?
      Spaceship::ConnectAPI.login(creds[:username], use_portal: false, use_tunes: true)
    end

    app = Spaceship::ConnectAPI::App.find(app_identifier)
    UI.user_error!("No App Store Connect app for #{app_identifier}") unless app

    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: marketing_version,
      build_number: build_number,
      platform: platform
    )
    build = builds.find { |item| item.version.to_s == build_number.to_s }
    unless build
      UI.user_error!(
        "Build #{build_number} for #{marketing_version} was not found. Upload it to TestFlight and wait for processing."
      )
    end

    state = build.processing_state.to_s
    if state == Spaceship::ConnectAPI::Build::ProcessingState::PROCESSING
      UI.user_error!(
        "Build #{build_number} is still processing. Wait until TestFlight finishes processing, then submit again."
      )
    elsif state != Spaceship::ConnectAPI::Build::ProcessingState::VALID
      UI.user_error!("Build #{build_number} cannot be submitted (processing state: #{state}).")
    end
  end

  def upload_credentials_hash
    if ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"] && ENV["ASC_API_KEY_PATH"]
      key = app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_filepath: ENV["ASC_API_KEY_PATH"],
        duration: 1200,
        in_house: false
      )
      { api_key: key }
    elsif ENV["FASTLANE_USER"]
      { username: ENV["FASTLANE_USER"] }
    else
      UI.user_error!(
        "Set FASTLANE_USER=your@email.com, or ASC_* API key env vars for CI"
      )
    end
  end
end
